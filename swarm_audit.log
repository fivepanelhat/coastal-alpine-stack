def get_mock_stored_hash(username: str) -> Optional[str]:
    """
    Simulates retrieving a hashed password for a given username from a secure store.
    In production, this would query a database or vault service (e.g., AWS Secrets Manager).
    Never hardcode hashes.
    """
    # Example: Use environment variables to simulate stored credentials
    if username == "admin":
        return os.environ.get("ADMIN_HASH")
    return None

def verify_password(plain_text_password: str, stored_hash: Optional[str]) -> bool:
    """
    Simulates a secure password comparison using a dedicated library (e.g., bcrypt or passlib).
    This function must handle timing attacks and never compare plain text directly.
    """
    if not stored_hash:
        return False

    # WARNING: This is a highly insecure placeholder for demonstration only.
    # A real implementation MUST use a cryptographic library like bcrypt or Argon2.
    MOCK_SECRET = "secure_admin_pass"
    return hashlib.sha256(plain_text_password.encode()).hexdigest() == MOCK_SECRET

def login(username: str, password: str) -> bool:
    """
    Authenticates user credentials against the secure credential store.

    Args:
        username: The provided username.
        password: The plain text password provided by the user.

    Returns:
        True if authentication succeeds, False otherwise.
    """
    # 1. Retrieve the stored hash securely
    stored_hash = get_mock_stored_hash(username)

    if not stored_hash:
        return False  # User does not exist or credentials are unavailable

    # 2. Use a dedicated function to compare the plaintext password against the stored hash.
    return verify_password(password, stored_hash)
```
